# Copy this file to .env and adjust values if needed:
#   copy .env.example .env

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=rootpass_change_me
MYSQL_DATABASE=kamailio
MYSQL_USER=kamailio
MYSQL_PASSWORD=kamailiorw_change_me
MYSQL_HOST_PORT=3306

# ---------- SIP / Kamailio ----------
# Softphone "Domain/Realm" should match this.
# Host/Server field is your PC IP (or 127.0.0.1), not necessarily this string.
SIP_DOMAIN=kamailio.local

# What Kamailio puts in Via / Record-Route (must be reachable by softphones)
# - Softphones on this PC: 127.0.0.1
# - Softphones on phone/laptop on the LAN: your PC LAN IP (e.g. 192.168.1.11)
ADVERTISED_IP=127.0.0.1

SIP_UDP_PORT=5060
SIP_TCP_PORT=5060

# Demo users (mysql/init + scripts/add-user.sql):
#   1001 / password1001
#   1002 / password1002
#   1003 / password1003
